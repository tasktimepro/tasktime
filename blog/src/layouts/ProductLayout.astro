---
import '../styles/global.css';
import '../styles/product.css';
import {
    DEFAULT_SOCIAL_IMAGE,
    DEFAULT_SOCIAL_IMAGE_ALT,
    SITE_DESCRIPTION,
    SITE_NAME,
    SITE_URL,
    TASKTIME_SOCIAL_URL,
    toAbsoluteUrl,
    toCanonicalUrl,
    toJsonLd,
} from '../config/site.js';
import { THEME_INIT_SCRIPT, THEME_TOGGLE_SCRIPT } from '../config/theme.js';

const {
    title,
    description,
    canonicalPath = '/product/',
    socialImage = DEFAULT_SOCIAL_IMAGE,
    socialImageAlt = DEFAULT_SOCIAL_IMAGE_ALT,
    activePage = 'product',
    softwareOffers = {
        '@type': 'Offer',
        name: 'Free',
        price: '0',
        priceCurrency: 'EUR',
    },
} = Astro.props;

const siteUrl = Astro.site ?? new URL(SITE_URL);
const canonicalUrl = toCanonicalUrl(canonicalPath, siteUrl);
const socialImageUrl = new URL(socialImage, SITE_URL).toString();
const currentYear = new Date().getFullYear();
const organizationId = toAbsoluteUrl('/#organization', SITE_URL);
const websiteId = toAbsoluteUrl('/#website', SITE_URL);
const webpageId = `${canonicalUrl}#webpage`;
const softwareId = `${canonicalUrl}#software`;
const structuredData = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'Organization',
            '@id': organizationId,
            name: SITE_NAME,
            url: toCanonicalUrl('/', siteUrl),
            logo: {
                '@type': 'ImageObject',
                url: toAbsoluteUrl(DEFAULT_SOCIAL_IMAGE, SITE_URL),
            },
            sameAs: [
                TASKTIME_SOCIAL_URL,
                'https://github.com/tasktimepro/tasktime',
            ],
        },
        {
            '@type': 'WebSite',
            '@id': websiteId,
            name: SITE_NAME,
            url: toCanonicalUrl('/', siteUrl),
            description: SITE_DESCRIPTION,
            publisher: {
                '@id': organizationId,
            },
        },
        {
            '@type': 'WebPage',
            '@id': webpageId,
            url: canonicalUrl,
            name: title,
            description,
            isPartOf: {
                '@id': websiteId,
            },
            mainEntity: {
                '@id': softwareId,
            },
        },
        {
            '@type': 'SoftwareApplication',
            '@id': softwareId,
            name: SITE_NAME,
            url: toCanonicalUrl('/', siteUrl),
            description,
            applicationCategory: 'BusinessApplication',
            operatingSystem: 'Any',
            browserRequirements: 'Requires a modern web browser. Core use works offline after the app is loaded or installed.',
            isAccessibleForFree: true,
            image: socialImageUrl,
            publisher: {
                '@id': organizationId,
            },
            offers: softwareOffers,
            featureList: [
                'Project and task planning',
                'Multiple project timers and time entries',
                'Expense and tax-period tracking',
                'Quotes, invoices, and payment tracking',
                'Reports and exports',
                'Optional Google Drive or Dropbox synchronization',
                'Optional same-device AI agent access',
            ],
        },
    ],
};
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <script is:inline set:html={THEME_INIT_SCRIPT}></script>
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="robots" content="index,follow" />
        <link rel="canonical" href={canonicalUrl} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
        <link rel="alternate" type="application/rss+xml" title="TaskTime Pro Blog" href="/blog/rss.xml" />
        <link rel="alternate" type="text/plain" title="TaskTime Pro llms.txt" href="/llms.txt" />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:image" content={socialImageUrl} />
        <meta property="og:image:alt" content={socialImageAlt} />
        <meta property="og:site_name" content="TaskTime Pro" />
        <meta property="og:locale" content="en_US" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImageUrl} />
        <meta name="twitter:image:alt" content={socialImageAlt} />
        <script type="application/ld+json" set:html={toJsonLd(structuredData)}></script>
    </head>
    <body>
        <div class="page-shell product-page-shell">
            <header class="site-header">
                <div class="site-header-top">
                    <a class="brand" href="/product/" aria-current={activePage === 'product' ? 'page' : undefined}>
                        <img class="brand-mark" src="/favicon.svg" alt="" aria-hidden="true" />
                        <span class="brand-label">TaskTime Pro</span>
                    </a>
                    <div class="site-header-controls">
                        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle color theme">
                            <span class="sr-only">Toggle color theme</span>
                            <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9"></path>
                            </svg>
                            <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                                <circle cx="12" cy="12" r="4"></circle>
                                <path d="M12 2v2"></path>
                                <path d="M12 20v2"></path>
                                <path d="m4.93 4.93 1.41 1.41"></path>
                                <path d="m17.66 17.66 1.41 1.41"></path>
                                <path d="M2 12h2"></path>
                                <path d="M20 12h2"></path>
                                <path d="m6.34 17.66-1.41 1.41"></path>
                                <path d="m19.07 4.93-1.41 1.41"></path>
                            </svg>
                        </button>
                    </div>
                </div>
                <nav class="site-nav" aria-label="Primary">
                    <div class="site-nav-links">
                        <a href="/pricing/" aria-current={activePage === 'pricing' ? 'page' : undefined}>Pricing</a>
                        <a href="/blog/">Blog</a>
                        <a href="/agents/">Agent Docs</a>
                    </div>
                    <div class="site-nav-actions">
                        <a href="/" class="cta-button">Open App</a>
                    </div>
                </nav>
            </header>

            <main class="site-main product-main">
                <slot />
            </main>

            <footer class="site-footer">
                <p class="footer-copyright">
                    <span class="footer-copyright-icon" aria-hidden="true">&copy;</span>
                    <span>{currentYear} TaskTime Pro. All rights reserved.</span>
                </p>
                <div class="footer-links">
                    <a class="footer-icon-link" href="https://x.com/tasktimepro" target="_blank" rel="noreferrer noopener" aria-label="TaskTime Pro on X">
                        <img src="/x.svg" alt="" aria-hidden="true" width="16" height="16" loading="lazy" />
                    </a>
                    <a class="footer-icon-link footer-icon-link--github" href="https://github.com/tasktimepro/tasktime" target="_blank" rel="noreferrer noopener" aria-label="TaskTime Pro on GitHub">
                        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" width="16" height="16">
                            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
                        </svg>
                    </a>
                    <a href="/agents/">Agent Docs</a>
                    <a href="/pricing/">Pricing</a>
                    <a href="/blog/">Blog</a>
                    <a href="/contact/">Contact</a>
                    <a href="/privacy/">Privacy</a>
                    <a href="/terms/">Terms</a>
                    <a href="/blog/rss.xml">RSS</a>
                </div>
            </footer>
        </div>
        <script is:inline set:html={THEME_TOGGLE_SCRIPT}></script>
    </body>
</html>
