---
import ProductLayout from '../../layouts/ProductLayout.astro';

const title = 'TaskTime Pro — Local-first work and invoicing for freelancers';
const description = 'Plan projects, track time and expenses, create invoices, review reports, and optionally work with AI agents in one free, open-source, local-first app.';

const benefits = [
    {
        label: 'Start immediately',
        title: 'No account required',
        description: 'Open TaskTime Pro and begin organizing work. Core use does not require a TaskTime account or cloud setup.',
    },
    {
        label: 'Keep ownership',
        title: 'Local-first by design',
        description: 'Your work records live in your browser. Optional Google Drive sync is there when you want backup or another device.',
    },
    {
        label: 'Stay in one flow',
        title: 'From planning to payment',
        description: 'Connect projects, tasks, time, expenses, invoices, payments, and reports without rebuilding the same context in separate tools.',
    },
    {
        label: 'Use it your way',
        title: 'Free and open source',
        description: 'Inspect the source, run it yourself, and follow how TaskTime Pro handles the workflows that matter to your business.',
    },
];

const capabilities = [
    {
        title: 'Projects and weekly planning',
        description: 'Organize clients, projects, tasks, subtasks, notes, estimates, deadlines, and the work you want to tackle each week.',
    },
    {
        title: 'Time that stays connected',
        description: 'Run multiple project timers, record manual entries, and keep every tracked interval attached to the task and project it belongs to.',
    },
    {
        title: 'Expenses and tax periods',
        description: 'Track one-time and recurring costs, currencies, categories, payment state, and tax-return progress alongside the related work.',
    },
    {
        title: 'Quotes, invoices, and payments',
        description: 'Turn eligible work and costs into clear quotes or invoices, then retain payment and billing context without duplicate entry.',
    },
    {
        title: 'Reports you can act on',
        description: 'Review time, revenue, expenses, outstanding invoices, and client activity, then export useful records when you need them.',
    },
    {
        title: 'Optional local agent access',
        description: 'Pair a same-device AI agent through scoped MCP tools while the browser remains the owner of your data and business actions.',
    },
];
---

<ProductLayout title={title} description={description}>
    <section class="product-hero" aria-labelledby="product-title">
        <div class="product-hero-copy">
            <p class="eyebrow">Free · Open source · No account required</p>
            <h1 id="product-title">Your work. Your time. Your data.</h1>
            <p class="product-hero-lede">
                TaskTime Pro brings projects, tasks, timers, expenses, invoices, and reports into one local-first
                workspace for freelancers and solo professionals.
            </p>
            <div class="product-actions">
                <a class="product-button product-button--primary" href="/">Open App</a>
                <a
                    class="product-button product-button--secondary"
                    href="https://github.com/tasktimepro/tasktime"
                    target="_blank"
                    rel="noreferrer noopener"
                    aria-label="View TaskTime Pro on GitHub (opens in a new tab)"
                >
                    View on GitHub
                </a>
            </div>
            <p class="product-action-note">Runs in your browser. Works offline after it is loaded or installed.</p>
        </div>

        <!-- Replace this figure with a 16:10 product screenshot while retaining the figure and caption. -->
        <figure class="product-media-placeholder product-media-placeholder--hero" data-screenshot-slot="dashboard-overview">
            <div class="product-media-placeholder__content">
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5">
                    <rect width="18" height="14" x="3" y="5" rx="2"></rect>
                    <path d="M3 10h18"></path>
                    <path d="M8 5v14"></path>
                    <path d="M11 14h6"></path>
                    <path d="M11 17h4"></path>
                </svg>
                <strong>Screenshot placeholder</strong>
                <span>Dashboard overview with today’s work, active projects, and report summary</span>
            </div>
            <figcaption>Suggested capture: desktop dashboard with realistic sample data.</figcaption>
        </figure>
    </section>

    <section class="product-benefit-grid" aria-label="Why TaskTime Pro">
        {benefits.map((benefit) => (
            <article class="product-benefit-card">
                <p>{benefit.label}</p>
                <h2>{benefit.title}</h2>
                <span>{benefit.description}</span>
            </article>
        ))}
    </section>

    <section class="product-section product-section--centered" aria-labelledby="capabilities-title">
        <div class="product-section-heading">
            <p class="eyebrow">One connected workspace</p>
            <h2 id="capabilities-title">Everything from the first task to the final invoice</h2>
            <p>
                TaskTime Pro keeps the context around your work intact, so planning, delivery, billing, and reporting
                reinforce each other instead of becoming separate admin jobs.
            </p>
        </div>
        <div class="product-capability-grid">
            {capabilities.map((capability, index) => (
                <article class="product-capability-card">
                    <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                    <h3>{capability.title}</h3>
                    <p>{capability.description}</p>
                </article>
            ))}
        </div>
    </section>

    <section class="product-story" aria-labelledby="planning-title">
        <div class="product-story-copy">
            <p class="eyebrow">Plan and track</p>
            <h2 id="planning-title">Know what needs attention—and where the time went</h2>
            <p>
                Plan work by week, keep tasks attached to the right project, and track time without losing the detail
                you will need when it is time to report or bill.
            </p>
            <ul class="product-check-list">
                <li>Weekly planner, task lists, and kanban views</li>
                <li>Multiple active timers across different projects</li>
                <li>Project notes, estimates, goals, and recent activity</li>
            </ul>
        </div>

        <!-- Replace this figure with a 16:10 product screenshot while retaining the figure and caption. -->
        <figure class="product-media-placeholder" data-screenshot-slot="planner-and-timers">
            <div class="product-media-placeholder__content">
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5">
                    <rect width="18" height="18" x="3" y="3" rx="2"></rect>
                    <path d="M8 2v4"></path>
                    <path d="M16 2v4"></path>
                    <path d="M3 9h18"></path>
                    <path d="M8 13h3"></path>
                    <path d="M8 17h7"></path>
                </svg>
                <strong>Screenshot placeholder</strong>
                <span>Weekly planner beside project tasks and running timers</span>
            </div>
            <figcaption>Suggested capture: planner week with two projects and one active timer.</figcaption>
        </figure>
    </section>

    <section class="product-story product-story--reverse" aria-labelledby="billing-title">
        <div class="product-story-copy">
            <p class="eyebrow">Invoice with context</p>
            <h2 id="billing-title">Turn completed work into billing without starting over</h2>
            <p>
                Bring eligible time, project estimates, flat-rate tasks, and expenses into quote and invoice workflows,
                then follow payments and reports from the same underlying records.
            </p>
            <ul class="product-check-list">
                <li>Reusable business details, templates, and payment methods</li>
                <li>Hourly, flat-rate, quoted, and mixed project work</li>
                <li>Invoice, revenue, expense, tax, and client reports</li>
            </ul>
        </div>

        <!-- Replace this figure with a 4:3 product screenshot while retaining the figure and caption. -->
        <figure class="product-media-placeholder product-media-placeholder--square" data-screenshot-slot="invoice-and-reports">
            <div class="product-media-placeholder__content">
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5">
                    <path d="M6 2h9l3 3v17H6z"></path>
                    <path d="M14 2v4h4"></path>
                    <path d="M9 11h6"></path>
                    <path d="M9 15h6"></path>
                    <path d="M9 19h3"></path>
                </svg>
                <strong>Screenshot placeholder</strong>
                <span>Invoice preview with related reporting context</span>
            </div>
            <figcaption>Suggested capture: polished invoice preview or invoice report overview.</figcaption>
        </figure>
    </section>

    <section class="product-principles" aria-labelledby="ownership-title">
        <div class="product-section-heading">
            <p class="eyebrow">Local-first by design</p>
            <h2 id="ownership-title">Useful before you create an account—because there is no required account</h2>
            <p>
                Core work records stay in browser-local storage and remain usable offline after TaskTime Pro is loaded
                or installed. Google Drive sync is optional, and routine Drive data moves directly between your browser
                and Google when you connect it.
            </p>
        </div>
        <div class="product-principle-list">
            <article>
                <h3>Your browser owns the work</h3>
                <p>Projects, clients, tasks, time entries, expenses, and invoices are not placed behind a hosted TaskTime account.</p>
            </article>
            <article>
                <h3>Cloud features stay optional</h3>
                <p>Connect Drive for backup and multi-device continuity, or keep the core workflow fully local.</p>
            </article>
            <article>
                <h3>Privacy boundaries stay explicit</h3>
                <p>Limited aggregate usage metrics exclude project, task, client, invoice, expense, note, and time-entry content.</p>
            </article>
        </div>
        <a class="product-text-link" href="/privacy/">Read the privacy policy <span aria-hidden="true">→</span></a>
    </section>

    <section class="product-agent-callout" aria-labelledby="agent-title">
        <div>
            <p class="eyebrow">Optional AI-agent access</p>
            <h2 id="agent-title">Let an agent help without handing over raw app storage</h2>
            <p>
                The first-party local MCP bridge gives same-device agents scoped tools for tasks, timers, expenses,
                reports, invoicing, and navigation. You pair the browser, control access, and keep sensitive actions
                behind TaskTime Pro’s approval rules.
            </p>
        </div>
        <a class="product-button product-button--secondary" href="/agents/">Explore Agent Docs</a>
    </section>

    <section class="product-open-source" aria-labelledby="open-source-title">
        <div>
            <p class="eyebrow">Open source</p>
            <h2 id="open-source-title">A work tool you can inspect</h2>
            <p>
                TaskTime Pro’s app, public site, tests, agent bridge, and public integrations are available on GitHub.
                Review the implementation, report an issue, or run the project yourself.
            </p>
        </div>
        <a
            class="product-button product-button--secondary"
            href="https://github.com/tasktimepro/tasktime"
            target="_blank"
            rel="noreferrer noopener"
            aria-label="Visit TaskTime Pro on GitHub (opens in a new tab)"
        >
            Visit GitHub
        </a>
    </section>

    <section class="product-final-cta" aria-labelledby="final-cta-title">
        <p class="eyebrow">No signup. No setup wall.</p>
        <h2 id="final-cta-title">Open TaskTime Pro and start with the work in front of you.</h2>
        <p>Your first project, task, and timer can stay entirely in your browser.</p>
        <a class="product-button product-button--primary" href="/">Open App</a>
    </section>
</ProductLayout>
