---
import ProductLayout from '../../layouts/ProductLayout.astro';
import ProductIcon from '../../components/ProductIcon.astro';
import {
    ArrowRightIcon,
    ArrowUpTrayIcon,
    CalendarDaysIcon,
    ChartBarIcon,
    CheckIcon,
    ClockIcon,
    CloudIcon,
    CodeIcon,
    DocumentTextIcon,
    HandCoinsIcon,
    LayoutDashboardIcon,
    ProjectIcon,
    ShieldCheckIcon,
    UserGroupIcon,
    WifiOffIcon,
} from '@/components/ui/icons';

const title = 'TaskTime Pro — Local-first work and invoicing for freelancers';
const description = 'Plan projects, track time and expenses, and invoice clients—all in one workspace. Get optional help from your own AI assistant when you need it.';

const capabilities = [
    {
        icon: ProjectIcon,
        title: 'Projects and weekly planning',
        description: 'Keep tasks, notes, and deadlines together, and plan the work ahead.',
    },
    {
        icon: ClockIcon,
        title: 'Time that stays connected',
        description: 'Use timers or manual entries to keep your hours attached to the right work.',
    },
    {
        icon: UserGroupIcon,
        title: 'Clients and business details',
        description: 'Keep client contacts and your billing details ready for the next project.',
    },
    {
        icon: HandCoinsIcon,
        title: 'Expenses and tax periods',
        description: 'Record project costs, recurring expenses, and tax-period progress.',
    },
    {
        icon: DocumentTextIcon,
        title: 'Quotes, invoices, and payments',
        description: 'Create quotes and invoices from your work, and follow what’s been paid.',
    },
    {
        icon: ChartBarIcon,
        title: 'Reports you can act on',
        description: 'See where your time goes, what you earn, and what’s still outstanding.',
    },
];
---

<ProductLayout title={title} description={description}>
    <section class="product-hero" aria-labelledby="product-title">
        <div class="product-hero-copy">
            <p class="eyebrow">Built for independent professionals</p>
            <h1 id="product-title">
                <span>Run your freelance business.</span>
                <span>From task to invoice.</span>
            </h1>
            <p class="product-hero-lede">
                Plan projects, track time and expenses, and invoice clients—all in one workspace. Get optional help from your own AI assistant when you need it.
            </p>
            <div class="product-actions">
                <a class="product-button product-button--primary" href="/">Open TaskTime Pro</a>
            </div>
            <p class="product-action-note">Start free. No signup.</p>
            <ul class="product-trust-strip" aria-label="TaskTime Pro essentials">
                <li>
                    <ProductIcon icon={ShieldCheckIcon} variant="inline" size={16} />
                    <span>Local-first</span>
                </li>
                <li>
                    <ProductIcon icon={CodeIcon} variant="inline" size={16} />
                    <span>Open source</span>
                </li>
                <li>
                    <ProductIcon icon={WifiOffIcon} variant="inline" size={16} />
                    <span>Works offline</span>
                </li>
            </ul>
        </div>

        <!-- Replace this figure with a 16:10 product screenshot while retaining the figure and caption. -->
        <figure class="product-media-placeholder product-media-placeholder--hero" data-screenshot-slot="dashboard-overview">
            <div class="product-media-placeholder__content">
                <ProductIcon icon={LayoutDashboardIcon} variant="inline" size={48} />
                <strong>Screenshot placeholder</strong>
                <span>Dashboard overview with today’s work, active projects, and report summary</span>
            </div>
            <figcaption>Suggested capture: desktop dashboard with realistic sample data.</figcaption>
        </figure>
    </section>

    <section class="product-solo" aria-labelledby="solo-title">
        <div>
            <p class="eyebrow">Your one-person team</p>
            <h2 id="solo-title">You’re solo. Your workload isn’t.</h2>
        </div>
        <div class="product-solo-copy">
            <p>
                You plan the projects, do the work, track the costs, and handle the invoices. TaskTime Pro keeps it all
                connected, so you can spend less time piecing your business together.
            </p>
            <p>
                Work directly in TaskTime Pro, or connect your own AI assistant to help manage the details.
            </p>
        </div>
    </section>

    <section class="product-section product-section--centered" aria-labelledby="capabilities-title">
        <div class="product-section-heading">
            <p class="eyebrow">One connected workspace</p>
            <h2 id="capabilities-title">Everything from the first task to the final invoice</h2>
            <p>
                Your tasks, time, expenses, and billing stay connected to the same clients and projects.
            </p>
        </div>
        <div class="product-capability-grid">
            {capabilities.map((capability) => (
                <article class="product-capability-card">
                    <ProductIcon icon={capability.icon} />
                    <h3>{capability.title}</h3>
                    <p>{capability.description}</p>
                </article>
            ))}
        </div>
    </section>

    <section class="product-story" aria-labelledby="planning-title">
        <div class="product-story-copy">
            <p class="eyebrow">Plan and track</p>
            <h2 id="planning-title">Know what needs attention—and where the time went</h2>
            <p>
                Plan work by week, keep tasks attached to the right project, and track time without losing the detail
                you will need when it is time to report or bill.
            </p>
            <ul class="product-check-list">
                <li><ProductIcon icon={CheckIcon} variant="inline" size={20} class="product-check-icon" /><span>Weekly planner, task lists, and kanban views</span></li>
                <li><ProductIcon icon={CheckIcon} variant="inline" size={20} class="product-check-icon" /><span>Multiple active timers across different projects</span></li>
                <li><ProductIcon icon={CheckIcon} variant="inline" size={20} class="product-check-icon" /><span>Project notes, estimates, goals, and recent activity</span></li>
            </ul>
        </div>

        <!-- Replace this figure with a 16:10 product screenshot while retaining the figure and caption. -->
        <figure class="product-media-placeholder" data-screenshot-slot="planner-and-timers">
            <div class="product-media-placeholder__content">
                <ProductIcon icon={CalendarDaysIcon} variant="inline" size={48} />
                <strong>Screenshot placeholder</strong>
                <span>Weekly planner beside project tasks and running timers</span>
            </div>
            <figcaption>Suggested capture: planner week with two projects and one active timer.</figcaption>
        </figure>
    </section>

    <section class="product-story product-story--reverse" aria-labelledby="billing-title">
        <div class="product-story-copy">
            <p class="eyebrow">Invoice with context</p>
            <h2 id="billing-title">Turn completed work into billing without starting over</h2>
            <p>
                Bring eligible time, project estimates, flat-rate tasks, and expenses into quote and invoice workflows,
                then follow payments and reports from the same underlying records.
            </p>
            <ul class="product-check-list">
                <li><ProductIcon icon={CheckIcon} variant="inline" size={20} class="product-check-icon" /><span>Reusable business details, templates, and payment methods</span></li>
                <li><ProductIcon icon={CheckIcon} variant="inline" size={20} class="product-check-icon" /><span>Hourly, flat-rate, quoted, and mixed project work</span></li>
                <li><ProductIcon icon={CheckIcon} variant="inline" size={20} class="product-check-icon" /><span>Invoice, revenue, expense, tax, and client reports</span></li>
            </ul>
        </div>

        <!-- Replace this figure with a 4:3 product screenshot while retaining the figure and caption. -->
        <figure class="product-media-placeholder product-media-placeholder--square" data-screenshot-slot="invoice-and-reports">
            <div class="product-media-placeholder__content">
                <ProductIcon icon={DocumentTextIcon} variant="inline" size={48} />
                <strong>Screenshot placeholder</strong>
                <span>Invoice preview with related reporting context</span>
            </div>
            <figcaption>Suggested capture: polished invoice preview or invoice report overview.</figcaption>
        </figure>
    </section>

    <section class="product-agent-callout" aria-labelledby="agent-title">
        <div>
            <p class="eyebrow">Works with your personal AI</p>
            <h2 id="agent-title">Let your AI help with the admin.</h2>
            <p>
                Connect a compatible AI assistant to organize tasks, track time, and prepare invoice drafts from your
                project’s unbilled work. Review the results in TaskTime Pro and approve sensitive actions.
            </p>
            <a class="product-text-link" href="/blog/ai-invoicing-agent-freelancers/">See how it works <ProductIcon icon={ArrowRightIcon} variant="inline" size={16} /></a>
        </div>
        <ul class="product-agent-examples" aria-label="Example requests for your AI assistant">
            <li><q>Show me the time I haven’t invoiced.</q></li>
            <li><q>Prepare a draft invoice for this project.</q></li>
        </ul>
    </section>

    <section class="product-principles" aria-labelledby="ownership-title">
        <div class="product-section-heading">
            <p class="eyebrow">Local-first by design</p>
            <h2 id="ownership-title">Your work. Your time. Your data.</h2>
            <p>
                Core work records stay in your browser and remain usable offline after TaskTime Pro is loaded or
                installed. Cloud sync is optional and keeps routine file transfers directly between your browser and
                the provider you choose.
            </p>
        </div>
        <div class="product-principle-list">
            <article>
                <ProductIcon icon={ShieldCheckIcon} />
                <h3>Start in your browser</h3>
                <p>Projects, clients, tasks, time entries, expenses, and invoices are not placed behind a hosted TaskTime Pro account.</p>
            </article>
            <article>
                <ProductIcon icon={CloudIcon} />
                <h3>Sync through your own cloud</h3>
                <p>Connect your Google Drive or Dropbox to back up your work and use it across devices. Sync stays optional.</p>
            </article>
            <article>
                <ProductIcon icon={ArrowUpTrayIcon} />
                <h3>Take your work with you</h3>
                <p>Export a backup of your workspace and restore it on another device. Your records stay yours.</p>
            </article>
        </div>
        <a class="product-text-link" href="/privacy/">Read the privacy policy <ProductIcon icon={ArrowRightIcon} variant="inline" size={16} /></a>
    </section>

    <section class="product-open-source" aria-labelledby="open-source-title">
        <div>
            <p class="eyebrow">Open source</p>
            <h2 id="open-source-title">A work tool you can inspect</h2>
            <p>
                TaskTime Pro’s app, public site, tests, agent bridge, and public integrations are available on GitHub.
                Review the implementation, report an issue, or run the project yourself.
            </p>
        </div>
        <a
            class="product-button product-button--secondary"
            href="https://github.com/tasktimepro/tasktime"
            target="_blank"
            rel="noreferrer noopener"
            aria-label="Visit TaskTime Pro on GitHub (opens in a new tab)"
        >
            Visit GitHub
        </a>
    </section>

    <section class="product-final-cta" aria-labelledby="final-cta-title">
        <p class="eyebrow">No signup. No setup wall.</p>
        <h2 id="final-cta-title">Open TaskTime Pro and start with the work in front of you.</h2>
        <p>Your first project, task, and timer can stay entirely in your browser.</p>
        <a class="product-button product-button--primary" href="/">Open TaskTime Pro</a>
    </section>
</ProductLayout>
